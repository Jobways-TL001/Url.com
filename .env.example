# Copy to .env.local and fill in. Set the same values in Vercel:
# Project Settings -> Environment Variables.
#
# Server-only: NEVER prefix any of these with REACT_APP_, or Create React App
# will inline them into the public browser bundle.

# --- Email (api/send-email.js) ----------------------------------------------
# SMTP server. 465 = implicit TLS; 587 = STARTTLS.
SMTP_HOST=p3plzcpnl505439.prod.phx3.secureserver.net
SMTP_PORT=465
# SMTP mailbox. Enquiries are sent AS this mailbox, with the visitor on
# Reply-To, so the message passes SPF/DMARC.
AUTH_USER=
AUTH_PASSWORD=

# --- Admin dashboard (/admin) -------------------------------------------------
# The single admin login. Use a long, unique password: changing it signs out
# every open admin session.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Stripe (api/stripe-webhook.js) -------------------------------------------
# Signing secret of the webhook endpoint (starts with whsec_). Stripe
# Dashboard -> Developers -> Webhooks -> your endpoint -> Signing secret.
# Without it, payment success/failure emails are not sent.
STRIPE_WEBHOOK_SECRET=
# Secret API key (sk_live_... or sk_test_..., same mode and account as the
# webhook). Stripe Dashboard -> Developers -> API keys. api/checkout.js uses
# it to charge each learner the course fee for their state (/admin -> State
# tax). Without it, no online payment is offered and the team follows up by
# email.
STRIPE_SECRET_KEY=

# --- Supabase -----------------------------------------------------------------
# Every enquiry is stored in public.contact_submissions before mail is
# attempted, and the /admin dashboard reads from it. Apply
# supabase/migrations/*.sql first. Find both under Supabase Dashboard ->
# Project Settings -> API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
