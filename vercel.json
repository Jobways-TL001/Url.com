{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    },
    "api/admin/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/auth?action=login"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin/auth?action=logout"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin/auth?action=session"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
